APP_ENV=dev
LOG_LEVEL=INFO
SQL_ECHO=false

DATABASE_URL=sqlite:///./codetrace.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

PROBLEMS_DIR=app/problems/data

# Seam. BE1의 judge / agent가 붙으면 이 값만 바꾼다. 코드 수정 불필요.
JUDGE_BACKEND=none          # none | docker
JUDGE_PATH=../judge         # JUDGE_BACKEND=docker일 때 sys.path에 추가할 경로
AGENT_BACKEND=none          # none | llm

# Monitor 임계값. 무대에서 90초가 길게 느껴지면 코드가 아니라 여기를 고친다.
MONITOR_NO_PROGRESS_SECONDS=90
MONITOR_SAME_RESULT_THRESHOLD=3
MONITOR_SAME_REGION_THRESHOLD=2
MONITOR_CONSECUTIVE_ERROR_THRESHOLD=3
MONITOR_COOLDOWN_SECONDS=30
MONITOR_LARGE_CHANGE_RATIO=0.5
MONITOR_LARGE_CHANGE_MIN_LINES=5
MONITOR_LARGE_CHANGE_WINDOW_SECONDS=60
MONITOR_RECENT_SCORE_WINDOW=5

# --- 인증 ---
# 운영에서는 반드시 바꾼다. 기본값을 그대로 쓰면 누구나 아무 사용자의 토큰을 만들 수 있다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- 도토리 정책 ---
# judge 문제 26개에 difficulty 가 전부 없어서 지금은 모두 BEGINNER(10) 로 수렴한다.
ACORN_REWARD_BEGINNER=10
ACORN_REWARD_INTERMEDIATE=15
ACORN_REWARD_ADVANCED=20
ACORN_REWARD_TRACE_COMPLETED=3
ACORN_COST_NICKNAME=5
ACORN_COST_AVATAR=10
