{
  "problem_id": "stdout_sort_three_numbers",
  "title": "세 수 정렬",
  "concept": [],
  "check_type": "stdout_match",
  "code_template": "# 여기에 코드를 작성하세요\n# 입력은 input()으로 받고, 출력은 print()로 출력하세요\n",
  "time_limit_sec": 1.0,
  "memory_limit_mb": 128,
  "public_test_cases": [
    {
      "stdin": "15 20 3\n",
      "expected_stdout": "3 15 20\n",
      "category": "sample_1"
    },
    {
      "stdin": "5 7 5\n",
      "expected_stdout": "5 5 7\n",
      "category": "sample_2"
    }
  ],
  "hidden_test_cases": [
    {
      "stdin": "-1 -5 -3\n",
      "expected_stdout": "-5 -3 -1\n",
      "category": "case_3"
    },
    {
      "stdin": "0 0 0\n",
      "expected_stdout": "0 0 0\n",
      "category": "case_4"
    },
    {
      "stdin": "9 1 2\n",
      "expected_stdout": "1 2 9\n",
      "category": "case_5"
    },
    {
      "stdin": "2 9 1\n",
      "expected_stdout": "1 2 9\n",
      "category": "case_6"
    },
    {
      "stdin": "100 -100 0\n",
      "expected_stdout": "-100 0 100\n",
      "category": "case_7"
    },
    {
      "stdin": "-7 4 -7\n",
      "expected_stdout": "-7 -7 4\n",
      "category": "case_8"
    }
  ]
