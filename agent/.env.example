# 사용할 모델 프로바이더: anthropic | openai | litellm | bedrock | none
# 이 프로젝트는 "로컬 에이전트"라 AWS 없이 API 키로 직접 호출하는 것이 기본입니다.
# 비워두면 anthropic을 기본값으로 사용합니다 (models.py DEFAULT_PROVIDER).
# AWS를 쓰기로 정하면 bedrock으로, Strands 자체 기본값을 쓰려면 none으로 바꾸세요.
MODEL_PROVIDER=anthropic
# 에이전트별로 다른 프로바이더/모델을 쓰고 싶다면 아래처럼 개별 지정 가능
# (미지정 시 위 MODEL_PROVIDER를 따름)
# 진입시점 판단은 더 이상 별도 LLM(EntryAgent)이 아니라 state_agent.py 안의 규칙 기반
# 게이트가 담당하므로 MODEL_PROVIDER_ENTRY는 사용하지 않는다.
# guidance/action은 guided_action 하나로 합쳐졌으므로 MODEL_PROVIDER_GUIDANCE /
# MODEL_PROVIDER_ACTION도 사용하지 않는다.
# MODEL_PROVIDER_STATE=anthropic
# MODEL_PROVIDER_GUIDED_ACTION=anthropic
# MODEL_PROVIDER_TUTOR_MESSAGE=anthropic
# MODEL_PROVIDER_EVALUATION=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
# 역할별로 모델을 따로 쓸 수도 있다 (미지정 시 위 ANTHROPIC_MODEL_ID를 따름).
#
# 판단이 아니라 분류/작문 위주인 단계(state의 앞단 탐지, evaluation의 정오 채점,
# tutor_message의 문장 생성)는 더 작고 빠른 haiku로도 정확도 손실이 적다. 반면
# 지도 방법을 정하는 guided_action, 정답 검증이 걸린 problem_generator는 sonnet을
# 유지하는 걸 권장한다. 파이프라인이 LLM 호출 최대 3번인 만큼 여기서 지연 시간을
# 크게 줄일 수 있다.
ANTHROPIC_MODEL_ID_STATE=claude-haiku-4-5
ANTHROPIC_MODEL_ID_EVALUATION=claude-haiku-4-5
ANTHROPIC_MODEL_ID_TUTOR_MESSAGE=claude-haiku-4-5

# LLM 호출 한 번의 최대 대기 시간(초). 초과하면 취소하고 예외를 올려서
# 호출부가 WAIT으로 폴백하게 한다 — 영속 이벤트 루프에 매달린 코루틴이 쌓이는
# 것보다 낫다 (llm_runtime.py 참고). 기본 120.
# LLM_CALL_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

LITELLM_MODEL_ID=

# --- state_agent.py 안의 규칙 기반 진입 게이트 임계값. 비워두면 기본값을 쓴다. ---
# (게이트를 통과해야만 StateAgent가 LLM을 호출한다)
# 유휴 시간(초): 키 입력 없이 이 정도 멈추면 신호 (기본 60)
# STATE_GATE_IDLE_THRESHOLD_SECONDS=60
# 같은 블록 정체(초): 커서가 같은 함수/블록을 못 벗어나면 신호 (기본 90)
# STATE_GATE_CURSOR_STUCK_THRESHOLD_SECONDS=90
# 쓰다 지우기 반복(churn) 횟수 (기본 3)
# STATE_GATE_EDIT_CHURN_THRESHOLD=3
# 연속 동일 실패 횟수 (기본 2)
# STATE_GATE_CONSECUTIVE_FAILURE_THRESHOLD=2
# 마지막 개입 후 이 시간(초) 안이면 재개입 스킵 (기본 300 = 5분)
# STATE_GATE_INTERVENTION_COOLDOWN_SECONDS=300
# "struggle" 분기로 LLM까지 넘기는 데 필요한 최소 신호 개수 (기본 2, 오탐 방지)
# STATE_GATE_MIN_STRUGGLE_SIGNALS=2

# problem_generator_agent가 judge_service를 직접 import할 때 sys.path에 넣을
# 경로 (backend의 JUDGE_PATH와 같은 용도). agent/ 기준 상대경로.
JUDGE_PATH=../judge

# --- backend <-> agent 서비스 배선 (아래 값들은 backend 프로세스 쪽에서 읽는다) ---
# agent는 별도 프로세스로 뜨고 backend가 HTTP로 부른다. 같은 venv에 넣을 수 없기
# 때문이다 (strands-agents가 끌어오는 starlette가 backend fastapi와 충돌).
# 자세한 건 README "연결 방법 C" 참고.
#
# agent 서비스 주소 (기본 http://localhost:8100)
# AGENT_SERVICE_URL=http://localhost:8100
# 읽기 타임아웃(초). 파이프라인이 LLM을 2번 순차 호출해서 실측 16~18초가 걸린다.
# 낮추면 "느리면 그냥 WAIT"가 되어 응답 속도를 지키는 대신 개입을 포기한다. (기본 30)
# AGENT_SERVICE_TIMEOUT_SECONDS=30
# 연결 타임아웃(초). 서비스가 안 떠 있을 때 빨리 포기하기 위해 읽기와 분리했다. (기본 0.5)
# AGENT_SERVICE_CONNECT_TIMEOUT_SECONDS=0.5
# http | inprocess. inprocess는 위 의존성 충돌이 해소돼야 쓸 수 있다. (기본 http)
# AGENT_WIRING=http
