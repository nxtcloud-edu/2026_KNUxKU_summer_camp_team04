# 사용할 모델 프로바이더: anthropic | openai | litellm | bedrock | none
# 이 프로젝트는 "로컬 에이전트"라 AWS 없이 API 키로 직접 호출하는 것이 기본입니다.
# 비워두면 anthropic을 기본값으로 사용합니다 (models.py DEFAULT_PROVIDER).
# AWS를 쓰기로 정하면 bedrock으로, Strands 자체 기본값을 쓰려면 none으로 바꾸세요.
MODEL_PROVIDER=anthropic
# 에이전트별로 다른 프로바이더/모델을 쓰고 싶다면 아래처럼 개별 지정 가능
# (미지정 시 위 MODEL_PROVIDER를 따름)
# MODEL_PROVIDER_ENTRY=anthropic
# MODEL_PROVIDER_STATE=anthropic
# MODEL_PROVIDER_GUIDANCE=anthropic
# MODEL_PROVIDER_ACTION=openai
# MODEL_PROVIDER_EVALUATION=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

LITELLM_MODEL_ID=

# problem_generator_agent가 judge_service를 직접 import할 때 sys.path에 넣을
# 경로 (backend의 JUDGE_PATH와 같은 용도). agent/ 기준 상대경로.
JUDGE_PATH=../judge
